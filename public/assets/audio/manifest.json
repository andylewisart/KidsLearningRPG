  },
  "knight": {
   "id": "onwK4e9ZLuTAKqWW03F9",
   "name": "Daniel",
   "model": "eleven_multilingual_v2",
   "why": "Deep, formal British broadcaster: calm, noble gravitas for a knight who narrates his own legend."
  },
  "gunner": {
   "id": "cgSgspJ2msm6clMCkdW9",
   "name": "Jessica",
   "model": "eleven_multilingual_v2",
   "why": "Bright, playful, energetic young American female, for a cocky, fast-talking sky-pirate."
  },
  "spellwright": {
